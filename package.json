{
  "name": "@jalik/react-form",
  "version": "6.1.1",
  "description": "Manage forms in React with ease.",
  "license": "MIT",
  "keywords": [
    "react",
    "form"
  ],
  "author": {
    "name": "Karl Stein",
    "email": "karl.stein.pro@gmail.com",
    "url": "https://github.com/jalik"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jalik/react-form.git"
  },
  "bugs": {
    "url": "https://github.com/jalik/react-form/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js"
    }
  },
  "files": [
    "esm/",
    "LICENSE.txt",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf ./esm && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run prepublishOnly",
    "test": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@jalik/deep-extend": "^3.0.2",
    "@jalik/observer": "^2.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
